{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landpagdeoferta",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/uploads/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "landpagdeoferta",
      "database_id": "bbf31939-174b-4dae-9360-33c1c6254dfc"
    }
  ],
  "vars": {
    "SYNC_KEY_ID": "local-primary",
    "PUBLIC_ORIGIN": "https://landpagdeoferta.pedrolopesdev07.workers.dev"
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "preview_urls": false
}
